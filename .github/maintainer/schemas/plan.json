{
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "nothing_to_do",
        "blocked"
      ]
    },
    "summary": {
      "type": "string"
    },
    "progress_post": {
      "type": "string"
    },
    "task_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "milestone": {
            "type": "string"
          },
          "area": {
            "type": "string",
            "enum": [
              "spells",
              "relics",
              "wizard",
              "enemies",
              "bosses",
              "rooms",
              "gameplay",
              "hud",
              "art",
              "audio",
              "story"
            ]
          },
          "skill": {
            "type": "string",
            "enum": [
              "code",
              "pixel-art",
              "music",
              "sfx",
              "writing",
              "level-design"
            ]
          },
          "size": {
            "type": "string",
            "enum": [
              "good first issue",
              "S",
              "M",
              "L"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "now",
              "soon",
              "later"
            ]
          },
          "what": {
            "type": "string"
          },
          "where": {
            "type": "string"
          },
          "specs": {
            "type": "string"
          },
          "example": {
            "type": "string"
          },
          "placeholder": {
            "type": "string"
          },
          "done_when": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "milestone",
          "area",
          "skill",
          "size",
          "status",
          "what",
          "where",
          "done_when"
        ],
        "additionalProperties": false
      }
    },
    "owner_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "body"
        ],
        "additionalProperties": false
      }
    },
    "playtest": {
      "type": "object",
      "properties": {
        "changes": {
          "type": "string"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "changes",
        "questions"
      ],
      "additionalProperties": false
    },
    "pr_title": {
      "type": "string"
    },
    "pr_body": {
      "type": "string"
    },
    "owner_questions": {
      "type": "array",
      "description": "Questions only the owner can answer (see Questions for the owner). May be empty.",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "A short question, for example: Allow sessions to run the Godot binary?"
          },
          "question": {
            "type": "string",
            "description": "What is needed and why, in plain words"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Each option with its trade-off"
          },
          "recommendation": {
            "type": "string"
          },
          "meanwhile": {
            "type": "string",
            "description": "What the bot does until the owner answers"
          },
          "owner_change": {
            "type": "boolean",
            "description": "true if the answer needs a change in an owner-only path"
          },
          "change": {
            "type": "string",
            "description": "For owner_change: the exact change (a diff or the new lines)"
          }
        },
        "required": [
          "title",
          "question",
          "recommendation",
          "meanwhile"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "status",
    "summary",
    "progress_post",
    "task_issues",
    "owner_issues"
  ],
  "additionalProperties": false
}
