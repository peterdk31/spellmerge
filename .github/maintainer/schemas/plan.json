{
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "nothing_to_do",
        "blocked"
      ]
    },
    "summary": {
      "type": "string"
    },
    "progress_post": {
      "type": "string"
    },
    "schedule_issues": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "description": "Backlog issues to move into the work queue now"
    },
    "unschedule_issues": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "description": "Scheduled issues to move back to the backlog"
    },
    "owner_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "body"
        ],
        "additionalProperties": false
      }
    },
    "checkpoint": {
      "type": "object",
      "description": "Only when the current milestone is done: the checkpoint issue that asks the owner to go, iterate or pivot",
      "properties": {
        "milestone": {
          "type": "string",
          "description": "e.g. M2 (the spell system)"
        },
        "built": {
          "type": "string"
        },
        "cut": {
          "type": "string"
        },
        "assessment": {
          "type": "string"
        },
        "question": {
          "type": "string",
          "description": "The checkpoint question of the milestone from docs/ROADMAP.md, if it has one"
        },
        "recommendation": {
          "type": "string",
          "description": "go, iterate on what, or pivot to what, and why"
        }
      },
      "required": [
        "milestone",
        "built",
        "assessment",
        "recommendation"
      ],
      "additionalProperties": false
    },
    "playtest": {
      "type": "object",
      "properties": {
        "changes": {
          "type": "string"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "changes",
        "questions"
      ],
      "additionalProperties": false
    },
    "pr_title": {
      "type": "string"
    },
    "pr_body": {
      "type": "string"
    },
    "owner_questions": {
      "type": "array",
      "description": "Questions only the owner can answer (see Questions for the owner). May be empty.",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "A short question, for example: Allow sessions to run the Godot binary?"
          },
          "key": {
            "type": "string",
            "description": "A short, stable kebab-case id for the decision, e.g. build-sh-four-bot-step. Use the same key whenever the same decision comes up again."
          },
          "question": {
            "type": "string",
            "description": "What is needed and why, in plain words"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Each option with its trade-off"
          },
          "recommendation": {
            "type": "string"
          },
          "meanwhile": {
            "type": "string",
            "description": "What the bot does until the owner answers"
          },
          "owner_change": {
            "type": "boolean",
            "description": "true if the answer needs a change in an owner-only path"
          },
          "change": {
            "type": "string",
            "description": "For owner_change: the exact change (a diff or the new lines)"
          },
          "screenshots": {
            "type": "array",
            "description": "Up to three shot scripts whose shots show exactly what the owner decides on (taken on this branch and shown in the question). Leave it out when nothing visible is involved.",
            "items": {
              "type": "object",
              "properties": {
                "script": {
                  "type": "string",
                  "description": "A tests/screenshots script name without .gd, e.g. shot_builder"
                },
                "caption": {
                  "type": "string",
                  "description": "One sentence: what to look at in these shots"
                }
              },
              "required": [
                "script",
                "caption"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "title",
          "question",
          "recommendation",
          "meanwhile"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "status",
    "summary",
    "progress_post",
    "owner_issues"
  ],
  "additionalProperties": false
}
