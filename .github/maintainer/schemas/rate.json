{
  "type": "object",
  "properties": {
    "scores": {
      "type": "object",
      "properties": {
        "fit": { "type": "integer", "minimum": 1, "maximum": 5 },
        "fun": { "type": "integer", "minimum": 1, "maximum": 5 },
        "quality": { "type": "integer", "minimum": 1, "maximum": 5 },
        "value": { "type": "integer", "minimum": 1, "maximum": 5 },
        "performance": { "type": "integer", "minimum": 1, "maximum": 5 },
        "risk": { "type": "integer", "minimum": 1, "maximum": 5 },
        "scope": { "type": "integer", "minimum": 1, "maximum": 5 }
      },
      "required": ["fit", "fun", "quality", "value", "performance", "risk", "scope"],
      "additionalProperties": false
    },
    "area_answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "question": { "type": "string" }, "answer": { "type": "string" } },
        "required": ["question", "answer"],
        "additionalProperties": false
      }
    },
    "decision": { "type": "string", "enum": ["merge", "changes", "close"] },
    "summary": { "type": "string" },
    "message": { "type": "string" },
    "change_requests": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "problem": { "type": "string" },
          "fix": { "type": "string" }
        },
        "required": ["problem", "fix"],
        "additionalProperties": false
      }
    },
    "close_reason": { "type": "string" },
    "fixups": { "type": "array", "items": { "type": "string" } },
    "description": { "type": "string" },
    "concerns": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["scores", "area_answers", "decision", "summary", "message", "change_requests", "fixups", "concerns"],
  "additionalProperties": false
}
