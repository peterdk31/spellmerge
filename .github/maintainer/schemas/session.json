{
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "blocked",
        "nothing_to_do"
      ]
    },
    "pr_title": {
      "type": "string"
    },
    "pr_body": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "screenshots": {
      "type": "array",
      "description": "The shot scripts that show what this change does, for the before/after screenshots on the PR. Empty when nothing visible changed.",
      "items": {
        "type": "object",
        "properties": {
          "script": {
            "type": "string",
            "description": "A tests/screenshots script name without .gd, e.g. shot_builder"
          },
          "caption": {
            "type": "string",
            "description": "One sentence: what to look at in these shots"
          }
        },
        "required": [
          "script",
          "caption"
        ],
        "additionalProperties": false
      }
    },
    "blocked_reason": {
      "type": "string"
    },
    "comment": {
      "type": "string"
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue": {
            "type": "integer"
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "issue",
          "body"
        ],
        "additionalProperties": false
      }
    },
    "owner_questions": {
      "type": "array",
      "description": "Questions only the owner can answer (see Questions for the owner). May be empty.",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "A short question, for example: Allow sessions to run the Godot binary?"
          },
          "key": {
            "type": "string",
            "description": "A short, stable kebab-case id for the decision, e.g. build-sh-four-bot-step. Use the same key whenever the same decision comes up again."
          },
          "question": {
            "type": "string",
            "description": "What is needed and why, in plain words"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Each option with its trade-off"
          },
          "recommendation": {
            "type": "string"
          },
          "meanwhile": {
            "type": "string",
            "description": "What the bot does until the owner answers"
          },
          "owner_change": {
            "type": "boolean",
            "description": "true if the answer needs a change in an owner-only path"
          },
          "change": {
            "type": "string",
            "description": "For owner_change: the exact change (a diff or the new lines)"
          }
        },
        "required": [
          "title",
          "question",
          "recommendation",
          "meanwhile"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "status",
    "summary"
  ],
  "additionalProperties": false
}
