# Godot
.godot/
*.translation
export_credentials.cfg

# Build output (builds are published only as GitHub Releases)
/build/
/dist/
*.pck
*.zip

# Secrets must never be committed (GitHub App private keys, tokens)
*.pem
*.key
.env

# Python
__pycache__/

# The native module's build (ci/build/native.sh): libraries and the file that names them
/native/bin/
/native/src/*.o
/native/src/*.os
/native/.sconsign*.dblite
/native/spellmerge.gdextension
/native/spellmerge.gdextension.uid
