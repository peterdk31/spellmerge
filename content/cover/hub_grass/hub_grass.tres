rate = 2.0
from = 2
at = Vector2(0, 5)
size = Vector2(12, 4)
spread = 60.0
reach = 3.0
height = 3.0
colours = Array[StringName]([&"fire", &"spark"])

[sub_resource type="Resource" id="burning_embers"]
