[gd_resource type="Resource" script_class="CoverKind" format=3]

[ext_resource type="Script" path="res://core/base/cover_kind.gd" id="1_kind"]
[ext_resource type="Script" path="res://core/base/cover_state.gd" id="2_state"]
[ext_resource type="Script" path="res://core/base/cover_trigger.gd" id="3_trigger"]
[ext_resource type="Script" path="res://core/base/mote_source.gd" id="4_motes"]
[ext_resource type="Texture2D" path="res://content/cover/hub_grass/tufts.svg" id="5_sheet"]

[sub_resource type="Resource" id="rest_fire"]
script = ExtResource("3_trigger")
when = 0
element = &"fire"
then = &"catching"

[sub_resource type="Resource" id="catching_frost"]
script = ExtResource("3_trigger")
when = 0
element = &"frost"
then = &"rest"

[sub_resource type="Resource" id="catching_water"]
script = ExtResource("3_trigger")
when = 0
element = &"water"
then = &"wet"

[sub_resource type="Resource" id="catching_after"]
script = ExtResource("3_trigger")
when = 1
seconds = 0.3
then = &"burning"

[sub_resource type="Resource" id="catching_embers"]
script = ExtResource("4_motes")
kind = &"ember"
rate = 2.0
from = 2
at = Vector2(0, 5)
size = Vector2(12, 4)
spread = 60.0
reach = 3.0
height = 3.0
colours = Array[StringName]([&"fire", &"spark"])

[sub_resource type="Resource" id="burning_frost"]
script = ExtResource("3_trigger")
when = 0
element = &"frost"
then = &"rest"

[sub_resource type="Resource" id="rest_water"]
script = ExtResource("3_trigger")
when = 0
element = &"water"
then = &"wet"

[sub_resource type="Resource" id="burning_water"]
script = ExtResource("3_trigger")
when = 0
element = &"water"
then = &"wet"

[sub_resource type="Resource" id="wet_after"]
script = ExtResource("3_trigger")
when = 1
seconds = 8.0
then = &"rest"

[sub_resource type="Resource" id="wet_glints"]
script = ExtResource("4_motes")
kind = &"drip"
rate = 0.6
from = 2
at = Vector2(0, -2)
size = Vector2(10, 4)
spread = 0.0
reach = 0.0
height = 3.0
colours = Array[StringName]([&"water"])

[sub_resource type="Resource" id="burning_after"]
script = ExtResource("3_trigger")
when = 1
seconds = 0.9
then = &"smouldering"

[sub_resource type="Resource" id="smouldering_after"]
script = ExtResource("3_trigger")
when = 1
seconds = 1.0
then = &"ash"

[sub_resource type="Resource" id="smouldering_smoke"]
script = ExtResource("4_motes")
kind = &"smoke"
rate = 1.0
from = 2
at = Vector2(0, 3)
size = Vector2(10, 4)
spread = 30.0
reach = 2.0
height = 7.0
colours = Array[StringName]([&"stone"])

[sub_resource type="Resource" id="ash_after"]
script = ExtResource("3_trigger")
when = 1
seconds = 30.0
then = &"rest"

[sub_resource type="Resource" id="burning_embers"]
script = ExtResource("4_motes")
kind = &"ember"
rate = 4.0
from = 2
at = Vector2(0, 3)
size = Vector2(12, 6)
spread = 60.0
reach = 4.0
height = 4.0
colours = Array[StringName]([&"fire", &"spark"])

[sub_resource type="Resource" id="burning_smoke"]
script = ExtResource("4_motes")
kind = &"smoke"
rate = 1.5
from = 2
at = Vector2(0, 2)
size = Vector2(10, 4)
spread = 40.0
reach = 3.0
height = 8.0
colours = Array[StringName]([&"stone"])

[sub_resource type="Resource" id="rest"]
script = ExtResource("2_state")
state_id = &"rest"
frames = PackedInt32Array(0, 1, 2, 8, 9, 10)
trampled_frames = PackedInt32Array(6, 7)
triggers = Array[ExtResource("3_trigger")]([SubResource("rest_fire"), SubResource("rest_water")])

[sub_resource type="Resource" id="catching"]
script = ExtResource("2_state")
state_id = &"catching"
frames = PackedInt32Array(11, 15, 12, 16, 17, 18)
sway = 0.8
bend = 0.6
motes = Array[ExtResource("4_motes")]([SubResource("catching_embers")])
status = &"burn"
status_strength = 2.0
status_duration = 1.5
status_every = 0.5
spreads = &"fire"
spread_chance = 0.6
triggers = Array[ExtResource("3_trigger")]([SubResource("catching_frost"), SubResource("catching_water"), SubResource("catching_after")])

[sub_resource type="Resource" id="burning"]
script = ExtResource("2_state")
state_id = &"burning"
frames = PackedInt32Array(3, 19, 4, 20, 21, 22)
sway = 0.5
bend = 0.3
motes = Array[ExtResource("4_motes")]([SubResource("burning_embers"), SubResource("burning_smoke")])
status = &"burn"
status_strength = 2.0
status_duration = 1.5
status_every = 0.5
spreads = &"fire"
spread_chance = 0.6
triggers = Array[ExtResource("3_trigger")]([SubResource("burning_frost"), SubResource("burning_water"), SubResource("burning_after")])

[sub_resource type="Resource" id="smouldering"]
script = ExtResource("2_state")
state_id = &"smouldering"
frames = PackedInt32Array(13, 23, 14, 24, 25, 26)
sway = 0.0
bend = 0.0
motes = Array[ExtResource("4_motes")]([SubResource("smouldering_smoke")])
triggers = Array[ExtResource("3_trigger")]([SubResource("smouldering_after")])

[sub_resource type="Resource" id="ash"]
script = ExtResource("2_state")
state_id = &"ash"
frames = PackedInt32Array(5)
sway = 0.0
bend = 0.0
triggers = Array[ExtResource("3_trigger")]([SubResource("ash_after")])

[sub_resource type="Resource" id="wet"]
script = ExtResource("2_state")
state_id = &"wet"
frames = PackedInt32Array(0, 1, 2, 8, 9, 10)
trampled_frames = PackedInt32Array(6, 7)
motes = Array[ExtResource("4_motes")]([SubResource("wet_glints")])
status = &"soak"
status_strength = 25.0
status_duration = 1.0
status_every = 0.5
triggers = Array[ExtResource("3_trigger")]([SubResource("wet_after")])

[resource]
script = ExtResource("1_kind")
id = &"hub_grass"
display_name = "Grass"
biomes = Array[StringName]([&"hub"])
fill_density = 0.035
clump_size = 3
wall_gap = 1
keep_gap = 1
sheet = ExtResource("5_sheet")
tufts_per_cell = 5
sway = 1.5
trample_hold = 5.0
trample_spring = 4.0
states = Array[ExtResource("2_state")]([SubResource("rest"), SubResource("catching"), SubResource("burning"), SubResource("smouldering"), SubResource("ash"), SubResource("wet")])
