[resource]
script = ExtResource("1_kind")
id = &"hub_grass"
display_name = "Grass"
biomes = Array[StringName]([&"hub"])
fill_density = 0.035
clump_size = 3
wall_gap = 1
keep_gap = 1
sheet = ExtResource("5_sheet")
tufts_per_cell = 5
sway = 1.5
trample_hold = 5.0
trample_spring = 4.0
states = Array[ExtResource("2_state")]([SubResource("rest"), SubResource("catching"), SubResource("burning"), SubResource("smouldering"), SubResource("ash"), SubResource("growing"), SubResource("doused"), SubResource("quenched"), SubResource("burning_doused"), SubResource("burning_quenched"), SubResource("wet")])
