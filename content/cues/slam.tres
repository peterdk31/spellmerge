parts = Array[Dictionary]([{"flash": &"burst", "zoom": 3}, {"flash": &"quake", "reach": 1.5, "way": &"right"}, {"part": &"motes", "kind": &"surface", "count": 50, "reach": 1.0, "spread": 360.0, "up": 1.8}, {"part": &"motes", "kind": &"spell", "count": 16, "reach": 0.6, "spread": 360.0}, {"part": &"mark", "mark": &"crack", "reach": 1.0}, {"part": &"motes", "kind": &"spark", "count": 10, "radius": 32.0, "spread": 160.0, "way": &"back"}])
shake = 0.45
kick = 3.0
hold = 0.06
