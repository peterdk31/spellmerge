[gd_resource type="Resource" script_class="EnemyBase" load_steps=8 format=3]

[ext_resource type="Script" path="res://core/base/enemy_base.gd" id="1_base"]
[ext_resource type="PackedScene" path="res://content/enemies/shooting_dummy/shooting_dummy.tscn" id="2_scene"]
[ext_resource type="Script" path="res://core/base/staff_base.gd" id="3_staff"]
[ext_resource type="Script" path="res://core/base/staff_cards.gd" id="4_entry"]
[ext_resource type="Resource" path="res://content/enemies/profiles/dummy.tres" id="5_profile"]

[sub_resource type="Resource" id="Resource_staff"]
script = ExtResource("3_staff")
id = &"shooting_dummy"
display_name = "Shooting dummy's staff"
slots = 2
draw = 1
cast_delay = 0.0
recharge = 0.0
spread = 0.0
