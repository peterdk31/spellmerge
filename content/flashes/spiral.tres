[gd_resource type="Resource" script_class="FlashKind" load_steps=2 format=3]

[ext_resource type="Script" path="res://core/base/flash_kind.gd" id="1_base"]

[resource]
script = ExtResource("1_base")
id = &"spiral"
seconds = 0.5
step = 10.0
room_light = 0.6
spiral_arms = 2
spiral_gap = 4.0
spiral = Array[Dictionary]([{"from_z": 10.0, "to_z": 3.0, "way": &"in"}, {"at": 0.9, "off": true}])
spiral_turn = Array[Dictionary]([{"from": 0.0, "to": 1.5, "way": &"out"}])
first = Array[Dictionary]([{"shade": &"hot"}])
second = Array[Dictionary]([{"shade": &"hi"}, {"at": 0.5, "shade": &"mid"}])
glow = Array[Dictionary]([{"from": 1.0, "to": 0.0, "way": &"out"}])
glow_ring = Array[Dictionary]([{"from": 0.5}])
glow_ring_reach = Array[Dictionary]([{"from_z": 3.0}])
glow_middle = Array[Dictionary]([{"from": 0.4}])
glow_middle_reach = Array[Dictionary]([{"from_z": 8.0}])
