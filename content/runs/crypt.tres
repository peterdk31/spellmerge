[gd_resource type="Resource" script_class="RunDefinition" load_steps=25 format=3]

[ext_resource type="Script" path="res://core/base/run_definition.gd" id="1_run"]
[ext_resource type="Script" path="res://core/base/map_rules.gd" id="2_rules"]
[ext_resource type="Script" path="res://core/base/kind_rule.gd" id="3_kind"]
[ext_resource type="Script" path="res://core/base/run_scaling.gd" id="4_scaling"]
[ext_resource type="Script" path="res://core/base/scale_curve.gd" id="5_curve"]
[ext_resource type="Script" path="res://core/base/spawn_rules.gd" id="6_spawning"]
[ext_resource type="Script" path="res://core/base/map_style.gd" id="7_style"]

[sub_resource type="Resource" id="fights"]
script = ExtResource("3_kind")
kind = &"fight"
first_row = 0
last_row = -2
least = 4

[sub_resource type="Resource" id="boss"]
script = ExtResource("3_kind")
kind = &"boss"
first_row = -1
last_row = -1
max_per_run = 1
least = 1
dead_end = true

[sub_resource type="Resource" id="reward"]
script = ExtResource("3_kind")
kind = &"reward"
first_row = 1
last_row = -2
max_per_run = 1
least = 1

[sub_resource type="Resource" id="shop"]
script = ExtResource("3_kind")
kind = &"shop"
first_row = 1
last_row = -2
max_per_run = 1
least = 1

[sub_resource type="Resource" id="secret"]
script = ExtResource("3_kind")
kind = &"secret"
first_row = 1
last_row = -2
max_per_run = 2
least = 1
chance = 0.5
dead_end = true

[sub_resource type="Resource" id="fountain"]
script = ExtResource("3_kind")
kind = &"fountain"
first_row = 1
last_row = -2
max_per_run = 1
chance = 0.5

[sub_resource type="Resource" id="treasure"]
script = ExtResource("3_kind")
kind = &"treasure"
first_row = 2
last_row = -2
max_per_run = 3
chance = 0.54
dead_end = true

[sub_resource type="Resource" id="challenge"]
script = ExtResource("3_kind")
kind = &"challenge"
first_row = 2
last_row = -2
max_per_run = 1
chance = 0.4
dead_end = true

[sub_resource type="Resource" id="spawning"]
script = ExtResource("6_spawning")
group_share = 0.35
refill_share = 0.15
stagger = 0.15

[sub_resource type="Resource" id="style_long"]
script = ExtResource("7_style")
id = &"long"
way_share = 0.75
branch_chain = 0.2

[sub_resource type="Resource" id="style_branching"]
script = ExtResource("7_style")
id = &"branching"
way_share = 0.4
branch_chain = 0.6

[sub_resource type="Resource" id="style_loop"]
script = ExtResource("7_style")
id = &"loop"
way_share = 0.45
branch_chain = 0.5
loops = 3
loop_pull = 5000.0

[sub_resource type="Resource" id="style_hub"]
script = ExtResource("7_style")
id = &"hub"
way_share = 0.35
branch_chain = 0.05
hub_pull = 6.0

[sub_resource type="Resource" id="crypt"]
script = ExtResource("2_rules")
biome = &"crypt"
room_budget = 16
spawning = SubResource("spawning")
kinds = Array[ExtResource("3_kind")]([SubResource("fights"), SubResource("boss"), SubResource("reward"), SubResource("shop"), SubResource("secret"), SubResource("fountain"), SubResource("treasure"), SubResource("challenge")])
rooms_min = 8
rooms_max = 12
start_kind = &"start"
fights_on_way = 4
scale_depth = 8
elite_depth = 3
elite_chance = 0.25
elite_cards = Array[StringName]([&"faster", &"bigger", &"pierce", &"homing"])
styles = Array[ExtResource("7_style")]([SubResource("style_long"), SubResource("style_branching"), SubResource("style_loop"), SubResource("style_hub")])

[sub_resource type="Resource" id="per_depth"]
script = ExtResource("5_curve")
start = 1.0
end = 1.5
easing = 1.0

[sub_resource type="Resource" id="per_player"]
script = ExtResource("5_curve")
start = 1.0
end = 1.3
easing = 1.0

[sub_resource type="Resource" id="scaling"]
script = ExtResource("4_scaling")
per_depth = SubResource("per_depth")
per_player = SubResource("per_player")

[resource]
script = ExtResource("1_run")
id = &"crypt"
display_name = "The Crypt"
biomes = Array[ExtResource("2_rules")]([SubResource("crypt")])
scaling = SubResource("scaling")
