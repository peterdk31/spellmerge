class_name MapRules
extends Resource
## The rules a run's map is generated by in one biome (run generation RG1, docs/milestones/
## run-generation.md, "The model"): how deep it is, how wide a row may be, how many ways a room may
## lead on, and which kinds of room may stand where (`kinds`, a table of `KindRule`s). One entry of
## `RunDefinition.biomes`. The generator (RG2) makes a map within them from the run's seed; `problems`
## says whether one can be made from the content there is.
##
## The map is rows of rooms: the first row is one room, where the party enters, and every room
## links to one or more of the next row's (`branches_min` to `branches_max`, never more than the
## next row holds), never crossing another's links, so every room can be reached from the first and
## leads on to the last row. A row no line of the table can fill from
## the content (only lines that are not `required`) is left out, so the map is that much shorter.

## The deepest a map may be and the widest a row (the editor's ranges; a rule change, run
## generation RG6, may not pass them either).
const MOST_DEPTH: int = 32
const MOST_WIDTH: int = 8

## The biome its rooms and enemies are of (`RoomBase.biome`, `EnemyBase.biomes`).
@export var biome: StringName = &""
## How many rows deep the map is, at least and at most (the last row the boss's when the table says so).
@export_range(1, 32) var depth_min: int = 4
@export_range(1, 32) var depth_max: int = 6
## How many rooms a row after the first may hold, at least and at most.
@export_range(1, 8) var width_min: int = 1
@export_range(1, 8) var width_max: int = 3
## How many rooms of the next row a room may lead to, at least and at most.
@export_range(1, 8) var branches_min: int = 1
@export_range(1, 8) var branches_max: int = 2
## Which kinds of room may stand in which rows, and how often.
@export var kinds: Array[KindRule] = []
## What a fight room's enemies cost at most together (`EnemyBase.cost`), before the run's scaling
## (RG5) grows it with depth and players: the generator (RG2) spends it on the biome's enemy pool.
@export_range(1, 200) var room_budget: int = 16


## The lines of the table that may stand in row `row` of a map `depth` rows deep and that the
## content can fill there, in the table's order.
func rules_at(content: RunContent, row: int, depth: int) -> Array[KindRule]:
	var found: Array[KindRule] = []
	for rule: KindRule in kinds:
		if rule != null and rule.takes_row(row, depth) and content.cannot_fill(biome, rule.kind, row) == "":
			found.append(rule)
	return found


## The rows of a map `depth` rows deep that the content can fill (the others are left out), in order.
func kept_rows(content: RunContent, depth: int) -> Array[int]:
	var rows: Array[int] = []
	for row in depth:
		if not rules_at(content, row, depth).is_empty():
			rows.append(row)
	return rows


## What is wrong with the rules, one line each (empty when a map can be made from `content` at every
## depth they allow): ranges out of order, a bad line of the table, a row no line may take, a
## required line that takes no row or that the content cannot fill, a kind that leads on with no
## template of exits enough for the ways a room may lead (`exit_problems`), and, at each depth, no row
## kept, a row whose lines may follow none of the row before's (`not_after`), too few rooms of a
## line allowed in the run for the rows that need it, or a row too wide to be reached from the one
## before.
func problems(content: RunContent) -> PackedStringArray:
	var found: PackedStringArray = _range_problems()
	if not found.is_empty():
		return found
	var known: Array[StringName] = content.kind_ids()
	for rule: KindRule in kinds:
		if rule == null:
			found.append("%s: an empty kind rule." % biome)
			continue
		for line: String in rule.problems(known):
			found.append("%s: %s" % [biome, line])
	if not found.is_empty():
		return found
	found.append_array(_required_problems(content))
	found.append_array(exit_problems(content))
	for depth in range(depth_min, depth_max + 1):
		found.append_array(_depth_problems(content, depth))
	return found


func _range_problems() -> PackedStringArray:
	var found := PackedStringArray()
	if biome == &"":
		found.append("Map rules name no biome.")
	if depth_max > MOST_DEPTH:
		found.append("%s: depth up to %d; %d at most." % [biome, depth_max, MOST_DEPTH])
	if width_max > MOST_WIDTH or branches_max > MOST_WIDTH:
		found.append("%s: width up to %d and branches up to %d; %d at most." % [biome, width_max, branches_max, MOST_WIDTH])
	if depth_min < 1 or depth_min > depth_max:
		found.append("%s: depth %d to %d; at least 1, the least first." % [biome, depth_min, depth_max])
	if width_min < 1 or width_min > width_max:
		found.append("%s: width %d to %d; at least 1, the least first." % [biome, width_min, width_max])
	if branches_min < 1 or branches_min > branches_max:
		found.append("%s: branches %d to %d; at least 1, the least first." % [biome, branches_min, branches_max])
	if kinds.is_empty():
		found.append("%s: no kind rules: no room could stand in the map." % biome)
	if room_budget < 1:
		found.append("%s: room_budget %d; at least 1." % [biome, room_budget])
	return found


## A required line that takes no row at any depth, or whose kind the content cannot fill in a row it takes.
func _required_problems(content: RunContent) -> PackedStringArray:
	var found := PackedStringArray()
	for rule: KindRule in kinds:
		if not rule.required:
			continue
		var takes: bool = false
		var why: String = ""
		for depth in range(depth_min, depth_max + 1):
			for row in depth:
				if rule.takes_row(row, depth):
					takes = true
					if why == "":
						why = content.cannot_fill(biome, rule.kind, row)
		if not takes:
			found.append("%s: kind '%s' is required, but it takes no row at %d to %d rows deep." % [biome, rule.kind, depth_min, depth_max])
		elif why != "":
			found.append("%s: kind '%s' is required, but %s." % [biome, rule.kind, why])
	return found


## A line of the table that may stand in a row with one after it (where the content fills it) whose
## kind no template of the biome hosts with exits enough for the most ways a room may lead on
## (`most_ways`; run generation RG4: a room leads to as many rooms as it has exits, and the generator
## never picks a template with fewer exits than its room's links).
func exit_problems(content: RunContent) -> PackedStringArray:
	var found := PackedStringArray()
	var ways: int = most_ways()
	var named: Dictionary = {}
	for rule: KindRule in kinds:
		if rule == null or named.has(rule.kind):
			continue
		var leads_on: bool = false
		for depth in range(depth_min, depth_max + 1):
			for row in depth - 1:
				leads_on = leads_on or (rule.takes_row(row, depth) and content.cannot_fill(biome, rule.kind, row) == "")
		if leads_on and content.templates_for(biome, rule.kind, ways).is_empty():
			named[rule.kind] = true
			found.append("%s: kind '%s' leads on, but no %s room hosting it has %d exits (props of the role %s) for the %d rooms it may lead to." % [biome, rule.kind, biome, ways, RoomBase.EXIT_ROLE, ways])
	return found


## The most rooms of the next row one room may lead to: `branches_max`, never more than a row holds.
func most_ways() -> int:
	return mini(branches_max, width_max)


func _depth_problems(content: RunContent, depth: int) -> PackedStringArray:
	var found := PackedStringArray()
	var at_depth: String = "%s, %d rows deep" % [biome, depth]
	for row in depth:
		var any: bool = false
		for rule: KindRule in kinds:
			any = any or rule.takes_row(row, depth)
		if not any:
			found.append("%s: no kind rule takes row %d." % [at_depth, row])
	if not found.is_empty():
		return found
	var rows: Array[int] = []
	var table: Array = []  # for each kept row, its lines (Array[KindRule])
	for row in depth:
		var here: Array[KindRule] = rules_at(content, row, depth)
		if not here.is_empty():
			rows.append(row)
			table.append(here)
	if rows.is_empty():
		found.append("%s: the content fills no row." % at_depth)
		return found
	# From the end: a line stays in its row only if a line of the next row may follow it.
	for at in range(rows.size() - 2, -1, -1):
		var leading: Array[KindRule] = leading_lines(table[at], table[at + 1])
		if leading.is_empty():
			found.append("%s: no kind of row %d may follow one of row %d (not_after)." % [at_depth, rows[at + 1], rows[at]])
			return found
		table[at] = leading
	if not _rows_matched(table):
		found.append("%s: the kinds' limits in a run (max_per_run) leave a row with no room." % at_depth)
	var reach: int = 1  # the most rooms the row before may hold; the first row is one room
	for at in range(1, rows.size()):
		var room: int = _row_room(table[at])
		var least: int = mini(width_min, room)
		if least > reach * branches_max:
			found.append("%s: row %d holds at least %d rooms, more than the %d of row %d can lead to." % [at_depth, rows[at], least, reach, rows[at - 1]])
		reach = mini(room, reach * branches_max)
	return found


## The lines of `before` that a line of `here` may follow (the generator keeps a row to these, so
## every room it places can lead on).
static func leading_lines(before: Array[KindRule], here: Array[KindRule]) -> Array[KindRule]:
	var found: Array[KindRule] = []
	for last: KindRule in before:
		for next: KindRule in here:
			if next.may_follow(last.kind):
				found.append(last)
				break
	return found


## The most rooms a row of these lines may hold: `width_max` at most, each line at most its
## `max_per_row` and its `max_per_run`.
func _row_room(rules: Array[KindRule]) -> int:
	var room: int = 0
	for rule: KindRule in rules:
		var most: int = width_max
		if rule.max_per_row > 0:
			most = mini(most, rule.max_per_row)
		if rule.max_per_run > 0:
			most = mini(most, rule.max_per_run)
		room += most
	return mini(room, width_max)


## True when every row of `table` (its lines, row by row) can hold one room of one of its lines,
## with no line used more often than its `max_per_run` (a matching of rows to lines, by augmenting
## paths).
static func _rows_matched(table: Array) -> bool:
	var taken: Dictionary = {}  # KindRule -> the rows holding it
	for at in table.size():
		if not _place(at, table, taken, {}):
			return false
	return true


static func _place(at: int, table: Array, taken: Dictionary, seen: Dictionary) -> bool:
	for rule: KindRule in table[at]:
		if seen.has(rule):
			continue
		seen[rule] = true
		var holders: Array = taken.get(rule, [])
		if rule.max_per_run == 0 or holders.size() < rule.max_per_run:
			holders.append(at)
			taken[rule] = holders
			return true
		for k in holders.size():
			if _place(holders[k], table, taken, seen):
				holders[k] = at
				return true
	return false
