class_name RunDefinition
extends Resource
## A kind of run (run generation RG1, docs/milestones/run-generation.md, "The model"): which
## features it has, as data; the game generates the whole run from it and the content there is
## (RG2), so no chain of rooms is made by hand. One file per kind of run, `content/runs/<id>.tres`,
## found by the registry under `runs`; the first is `crypt`.
##
## Its biomes are played in order, each by its own map rules. One biome for now: the generator
## plays the first until a second biome exists (docs/milestones/run-generation.md, "Not in this plan").

## Unique name of the run, also its file name; the registry finds it by this.
@export var id: StringName = &""
## Its name for people; empty: its id in words.
@export var display_name: String = ""
## Its biomes in order, each with the rules its map is generated by.
@export var biomes: Array[MapRules] = []
## How it grows harder with depth and players (run generation RG5; null: the same everywhere).
@export var scaling: RunScaling = null
## What the save may unlock in its rules (run generation RG6, `RunRuleChange`: a save flag and the
## number it changes), applied in this order when the run's unlocks hold their flags
## (`changed_by`). None yet: the first arrive with meta progression.
@export var changes: Array[RunRuleChange] = []


## Its name for people: `display_name`, else its id in words.
func shown_name() -> String:
	return display_name if display_name != "" else String(id).capitalize()


## The scale of a room `depth` rows into a map of `rules` (one of `biomes`), in a run of `players`
## players (`RunScaling.room_scale`; 1 with no `scaling`).
func room_scale(rules: MapRules, depth: int, players: int) -> float:
	if scaling == null:
		return 1.0
	return scaling.room_scale(depth, rules.depth_max - 1, players)


## How many depths the hub's lectern offers a run of it to start at (run generation RG7): one a row
## of its first biome's deepest map (`MapRules.depth_max`), "Room 1" to the last, the boss's (none
## with no biome). A map made shallower starts a pick past its rows in its deepest row before the
## last, and the last pick always in its last row (`RunMap.start_at`).
func start_depths() -> int:
	var rules: MapRules = biomes[0] if not biomes.is_empty() else null
	return rules.depth_max if rules != null else 0


## The save flags its rule changes name, each once, in their order.
func flags() -> Array[StringName]:
	var found: Array[StringName] = []
	for change: RunRuleChange in changes:
		if change != null and change.flag != &"" and not found.has(change.flag):
			found.append(change.flag)
	return found


## The definition a run plays with `unlocks` (the run's, core/sim/run_unlocks.gd): itself when they
## hold none of its changes' flags, else a copy of its own (`copied`) with each change whose flag
## they hold applied, in order, and no changes of its own. The registry's definition is never changed.
func changed_by(unlocks: RunUnlocks) -> RunDefinition:
	var made: RunDefinition = null
	for change: RunRuleChange in changes:
		if change == null or unlocks == null or not unlocks.has(change.flag):
			continue
		if made == null:
			made = copied()
		made.scaling = change.apply_to(made.biomes, made.scaling)
	if made == null:
		return self
	# The rules played are final: a copy has no changes left to apply (its `problems` checks it as
	# it is, never applying them twice).
	made.changes = [] as Array[RunRuleChange]
	return made


## The changes of the run stats a run of it plays with `unlocks` (connected biomes CB10,
## `RunStats`): each rule change of the `RUN_STAT` target whose flag they hold, in order. Empty
## with none.
func stat_changes_by(unlocks: RunUnlocks) -> Array[StatChange]:
	var made: Array[StatChange] = []
	for change: RunRuleChange in changes:
		if change != null and change.is_stat_target() and unlocks != null and unlocks.has(change.flag):
			made.append(change.as_stat_change())
	return made


## A copy of its own, down to every biome's rules, their kind rules and the scaling's curves (the
## changes are shared: read-only), so changing it changes nothing else.
func copied() -> RunDefinition:
	var made: RunDefinition = duplicate(false)
	var biomes_made: Array[MapRules] = []
	for rules: MapRules in biomes:
		biomes_made.append(rules.copied() if rules != null else null)
	made.biomes = biomes_made
	made.scaling = scaling.copied() if scaling != null else null
	made.changes = changes.duplicate()
	return made


## What is wrong with the definition, one line each (empty when every biome's rules can make a map
## from `content`): no id, no biome, an empty entry, a biome twice, each biome's `MapRules.problems`,
## the scaling's (`RunScaling.problems`) and the rule changes' (`change_problems`).
func problems(content: RunContent) -> PackedStringArray:
	var found := PackedStringArray()
	var name: String = String(id) if id != &"" else "A run"
	if id == &"":
		found.append("A run definition has no id.")
	if biomes.is_empty():
		found.append("%s: no biomes." % name)
	var seen: Array[StringName] = []
	for at in biomes.size():
		var rules: MapRules = biomes[at]
		if rules == null:
			found.append("%s: biome %d is empty." % [name, at])
			continue
		if rules.biome != &"" and seen.has(rules.biome):
			found.append("%s: biome '%s' twice." % [name, rules.biome])
		seen.append(rules.biome)
		for line: String in rules.problems(content):
			found.append("%s: %s" % [name, line])
	if scaling != null:
		found.append_array(scaling.problems(name))
	if found.is_empty():
		found.append_array(change_problems(content))
	return found


## What is wrong with its rule changes, one line each: an empty entry, each change's own
## (`RunRuleChange.problems`), and the rules a flag leaves that can make no map: with each flag
## alone, and with every flag at once (each set of flags between is not tried), and more flags than
## a run's start carries (`RunUnlocks.MAX_FLAGS`; the registry checks all runs together too).
func change_problems(content: RunContent) -> PackedStringArray:
	var found := PackedStringArray()
	var name: String = String(id) if id != &"" else "A run"
	for change: RunRuleChange in changes:
		if change == null:
			found.append("%s: an empty rule change." % name)
		else:
			found.append_array(change.problems(biomes, name))
	if flags().size() > RunUnlocks.MAX_FLAGS:
		found.append("%s: its rule changes name %d flags, more than the %d a run's start carries." % [name, flags().size(), RunUnlocks.MAX_FLAGS])
	if not found.is_empty():
		return found
	var sets: Array = []
	for flag: StringName in flags():
		sets.append([flag] as Array[StringName])
	if sets.size() > 1:
		sets.append(flags())
	for flag_set: Array in sets:
		var with: Array[StringName] = []
		with.assign(flag_set)
		var changed: RunDefinition = changed_by(RunUnlocks.of(with))
		if changed == self:
			continue
		for line: String in changed.problems(content):
			found.append("With %s unlocked: %s" % [", ".join(PackedStringArray(with)), line])
	return found
