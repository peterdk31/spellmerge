class_name RunRuleChange
extends Resource
## One change to the rules a run is generated by, made when a save flag is set (run generation RG6,
## docs/milestones/run-generation.md, "Meta progression (RG6)"): what meta progression unlocks. It
## names the flag (`flag`, a `SaveFile` flag) and one number of the run definition it changes
## (`target`): a kind rule's weight or limit, the map's depth or width, or a scaling factor (a
## curve's start or end), set to, raised by or multiplied by `amount` (`how`). A sub-resource of
## `RunDefinition.changes`, applied in their order (`RunDefinition.changed_by`).
##
## The flags in effect are the host's (core/sim/run_unlocks.gd: worked out from the save of the
## machine that starts the run, carried in its start and its replay's header), so every machine and
## every replay changes the rules alike. Read-only content, shared like a card: `apply_to` changes a
## copy, never the definition the registry holds.

## What it changes.
enum Target {
	## A kind rule's `weight` (`biome`'s line of `kind`).
	KIND_WEIGHT,
	## A kind rule's `max_per_row`.
	KIND_MAX_PER_ROW,
	## A kind rule's `max_per_run`.
	KIND_MAX_PER_RUN,
	## The map's `depth_min` (`biome`'s rules).
	DEPTH_MIN,
	## The map's `depth_max`.
	DEPTH_MAX,
	## The map's `width_min`.
	WIDTH_MIN,
	## The map's `width_max`.
	WIDTH_MAX,
	## The scaling per depth's `start` (the run's `scaling`).
	SCALE_DEPTH_START,
	## The scaling per depth's `end`.
	SCALE_DEPTH_END,
	## The scaling per player's `start`.
	SCALE_PLAYER_START,
	## The scaling per player's `end`.
	SCALE_PLAYER_END,
}

## How `amount` changes the number.
enum How {
	## The number becomes `amount`.
	SET,
	## The number grows by `amount` (below 0: shrinks).
	ADD,
	## The number is multiplied by `amount`.
	TIMES,
}

## The member of a `KindRule` each kind target changes.
const KIND_MEMBERS: Dictionary = {
	Target.KIND_WEIGHT: &"weight",
	Target.KIND_MAX_PER_ROW: &"max_per_row",
	Target.KIND_MAX_PER_RUN: &"max_per_run",
}
## The member of a `MapRules` each map target changes.
const MAP_MEMBERS: Dictionary = {
	Target.DEPTH_MIN: &"depth_min",
	Target.DEPTH_MAX: &"depth_max",
	Target.WIDTH_MIN: &"width_min",
	Target.WIDTH_MAX: &"width_max",
}
## The curve of `RunScaling` and the member of its `ScaleCurve` each scaling target changes.
const SCALE_MEMBERS: Dictionary = {
	Target.SCALE_DEPTH_START: [&"per_depth", &"start"],
	Target.SCALE_DEPTH_END: [&"per_depth", &"end"],
	Target.SCALE_PLAYER_START: [&"per_player", &"start"],
	Target.SCALE_PLAYER_END: [&"per_player", &"end"],
}

## The save flag that makes it (a plain id: letters, digits, `_`; core/sim/run_unlocks.gd).
@export var flag: StringName = &""
## What it changes.
@export var target: Target = Target.KIND_WEIGHT
## The biome whose rules it changes (`MapRules.biome`), for a kind or map target; empty: every
## biome of the run. A scaling target is the run's and names none.
@export var biome: StringName = &""
## The kind whose line it changes (`KindRule.kind`), for a kind target.
@export var kind: StringName = &""
## How `amount` changes the number.
@export var how: How = How.SET
## The amount (a whole number's result is rounded). A kind rule's limit of 0 is no limit: ADD makes
## it a limit of `amount`, TIMES leaves it none; SET it to 0 to lift a limit.
@export var amount: float = 0.0


## A change of `target` by `of_amount` (`by`) when `of_flag` is set.
static func make(of_flag: StringName, of_target: Target, of_amount: float, by: How = How.SET, of_biome: StringName = &"", of_kind: StringName = &"") -> RunRuleChange:
	var change := RunRuleChange.new()
	change.flag = of_flag
	change.target = of_target
	change.amount = of_amount
	change.how = by
	change.biome = of_biome
	change.kind = of_kind
	return change


## True for a target of a kind rule's.
func is_kind_target() -> bool:
	return KIND_MEMBERS.has(target)


## True for a target of the run's scaling.
func is_scale_target() -> bool:
	return SCALE_MEMBERS.has(target)


## The number `value` changed by it.
func changed(value: float) -> float:
	match how:
		How.ADD:
			return value + amount
		How.TIMES:
			return value * amount
	return amount


## Change `definition` (a copy of its own, `RunDefinition.copied`: never the registry's) as it says.
## A scaling target on a run with no scaling, or no such curve, gives it one at 1 first; a kind
## target changes every line of its kind in the biomes it names; a target that names nothing there
## changes nothing (`problems` says so).
func apply_to(definition: RunDefinition) -> void:
	if is_scale_target():
		var names: Array = SCALE_MEMBERS[target]
		if definition.scaling == null:
			definition.scaling = RunScaling.new()
		var curve: ScaleCurve = definition.scaling.get(names[0]) as ScaleCurve
		if curve == null:
			curve = ScaleCurve.new()
			definition.scaling.set(names[0], curve)
		curve.set(names[1], changed(curve.get(names[1]) as float))
		return
	for rules: MapRules in definition.biomes:
		if rules == null or (biome != &"" and rules.biome != biome):
			continue
		if is_kind_target():
			var member: StringName = KIND_MEMBERS[target]
			for rule: KindRule in rules.kinds:
				if rule != null and rule.kind == kind:
					_change_member(rule, member)
		else:
			_change_member(rules, MAP_MEMBERS[target])


## Its member `member` of `of` changed: rounded when that is a whole number.
func _change_member(of: Object, member: StringName) -> void:
	var value: Variant = of.get(member)
	if value is int:
		of.set(member, roundi(changed(float(value))))
	else:
		of.set(member, changed(value as float))


## What is wrong with it in `definition`, one line each, named by `what` (the run): no flag or one
## that is not a plain id, an amount that is not finite, a biome the run has not, a kind target with
## no kind or one no line of its biomes has, a scaling target naming a biome.
func problems(definition: RunDefinition, what: String) -> PackedStringArray:
	var found := PackedStringArray()
	var named: String = "%s: the rule change of '%s'" % [what, flag]
	if flag == &"":
		found.append("%s: a rule change names no save flag." % what)
	elif not RunUnlocks.is_flag(flag):
		found.append("%s: its flag is not a plain id (letters, digits, `_`, %d at most)." % [named, RunUnlocks.MAX_FLAG])
	if not is_finite(amount):
		found.append("%s: its amount %s is not a number." % [named, amount])
	if is_scale_target():
		if biome != &"" or kind != &"":
			found.append("%s: it changes the run's scaling, so it names no biome or kind." % named)
		return found
	var lines: int = 0
	var biomes: int = 0
	for rules: MapRules in definition.biomes:
		if rules == null or (biome != &"" and rules.biome != biome):
			continue
		biomes += 1
		for rule: KindRule in rules.kinds:
			if rule != null and kind != &"" and rule.kind == kind:
				lines += 1
	if biomes == 0:
		found.append("%s: the run has no biome '%s'." % [named, biome])
	elif is_kind_target():
		if kind == &"":
			found.append("%s: it changes a kind rule, but names no kind." % named)
		elif lines == 0:
			found.append("%s: no kind rule of '%s' to change." % [named, kind])
	elif kind != &"":
		found.append("%s: it changes the map, so it names no kind." % named)
	return found
