#!/usr/bin/env python
# SPDX-FileCopyrightText: 2026 peterdk31 and Spellmerge contributors
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Builds the native module (native/README.md) with godot-cpp. Run by ci/build/native.sh, which
# fetches the pinned godot-cpp and SCons and passes godot_cpp=<its folder>:
#   ci/build/native.sh [linux|windows|web ...]
import os
import sys

godot_cpp = ARGUMENTS.get("godot_cpp", os.environ.get("GODOT_CPP", ""))
if not godot_cpp:
    raise SystemExit("godot_cpp=<path to godot-cpp> is needed (ci/build/native.sh passes it)")

# The API of the pinned Godot (ci/build/godot.env); an extension built for it loads in 4.7 and later.
# Only the engine classes the module uses are generated (build_profile.json): a full godot-cpp is
# about a thousand files and minutes of compiling.
# godot-cpp reads the profile from the command line's variables only.
ARGUMENTS.setdefault("build_profile", File("build_profile.json").abspath)
# The desktop builds are the game's first target (the owner, 2026-11-22): linked as one program
# (link-time optimisation), so godot-cpp's packed-array methods and the module's calls from one of
# its files into another are inlined. godot-cpp's release target is -O3 already (`optimize=speed`).
# The platform as godot-cpp reads it: `platform=` or `p=`, else the machine's own.
HOST_PLATFORM = {"linux": "linux", "win32": "windows"}.get(sys.platform, "")
desktop = ARGUMENTS.get("platform", ARGUMENTS.get("p", HOST_PLATFORM)) in ("linux", "windows")
if desktop:
    ARGUMENTS.setdefault("lto", "full")
env = SConscript(os.path.join(godot_cpp, "SConstruct"), {"api_version": "4.7"})

env.Append(CPPPATH=["src/"])
# The same floats on every platform (online-ready N7, src/dmath.h): no multiply fused with an add
# (an FMA rounds once where the GDScript twin rounds twice) and no fast-math, for every compiler the
# module is built with (GCC for Linux and MinGW, Clang for the web).
FLOAT_FLAGS = ["-ffp-contract=off", "-fno-fast-math"]
env.Append(CCFLAGS=FLOAT_FLAGS)
# With link-time optimisation (the desktop) the code is made at the link, so the link is told the same.
if desktop:
    env.Append(LINKFLAGS=FLOAT_FLAGS)
# The desktop's vector instructions: x86-64-v2 (SSE4.2, POPCNT; every x86-64 CPU since 2009)
# in place of godot-cpp's plain x86-64 (SSE2). They change no result: without fast-math the
# compiler never reorders a float sum to vectorise it, and with no contraction (above) never fuses.
cpu = ARGUMENTS.get("cpu", "x86-64-v2")
if env["platform"] in ("linux", "windows") and env["arch"] == "x86_64":
    env.Append(CCFLAGS=["-march=" + cpu], LINKFLAGS=["-march=" + cpu])
# The module's own threads (src/jobs.cpp, shot scale H5): std::thread wants -pthread on Linux.
# MinGW links its thread runtime in with the C++ one (godot-cpp's use_static_cpp: -static), and the
# web is built without threads (ci/build/native.sh: threads=no, so jobs.cpp runs every loop on the
# calling thread).
if env["platform"] == "linux":
    env.Append(CCFLAGS=["-pthread"], LINKFLAGS=["-pthread"])
sources = Glob("src/*.cpp")

library = env.SharedLibrary(
    "bin/libspellmerge{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)
env.NoCache(library)
Default(library)
