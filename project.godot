; Engine configuration file.
; Edited by hand and by Claude's PRs; keep it in Godot's own format.

config_version=5

[application]

config/name="Spellmerge"
config/description="Merge spells. Cause chaos. Together."
config/version="dev"
run/main_scene="res://hud/menus/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.105882, 0.0941176, 0.188235, 1)
boot_splash/show_image=false

[autoload]

Events="*res://core/events/events.gd"
Registry="*res://core/registry/registry.gd"
PlayerInput="*res://core/input/input_manager.gd"
UIFocus="*res://core/ui_focus/ui_focus.gd"
Projectiles="*res://core/projectiles/projectile_manager.gd"
Combat="*res://gameplay/combat/combat.gd"
Feel="*res://gameplay/feel/feel.gd"
Flow="*res://gameplay/flow/flow.gd"
Coop="*res://gameplay/coop/coop.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

