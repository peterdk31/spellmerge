[gd_resource type="Resource" script_class="PropBase" load_steps=22 format=3]

[ext_resource type="Script" path="res://core/base/prop_base.gd" id="1_base"]
[ext_resource type="Script" path="res://core/base/staff_base.gd" id="2_staff"]
[ext_resource type="Script" path="res://core/base/staff_cards.gd" id="3_entry"]
[ext_resource type="Script" path="res://core/base/prop_reaction.gd" id="4_reaction"]
[ext_resource type="Script" path="res://core/base/prop_state.gd" id="5_state"]
[ext_resource type="PackedScene" path="res://content/props/base/prop.tscn" id="6_scene"]

[sub_resource type="Resource" id="fuse_staff"]
script = ExtResource("2_staff")
display_name = "Barrel's fuse"
slots = 2
wind_up = 1.0
cooldown = 0.0
max_mana = 100.0
mana_regen = 0.0

[sub_resource type="Resource" id="blast_staff"]
script = ExtResource("2_staff")
display_name = "Barrel's blast"
slots = 2
cooldown = 0.0
max_mana = 100.0
mana_regen = 0.0

[sub_resource type="Resource" id="fuse"]
script = ExtResource("3_entry")
staff = SubResource("fuse_staff")
cards = Array[StringName]([&"fire", &"blast"])

[sub_resource type="Resource" id="blast"]
script = ExtResource("3_entry")
staff = SubResource("blast_staff")
cards = Array[StringName]([&"fire", &"blast"])

[sub_resource type="Resource" id="idle_fire"]
script = ExtResource("4_reaction")
element = &"fire"
then = &"fusing"

[sub_resource type="Resource" id="idle_death"]
script = ExtResource("4_reaction")
when = 4
cast = 2
then = &"broken"

[sub_resource type="Resource" id="idle_cast2"]
script = ExtResource("4_reaction")
when = 6
staff = 2
then = &"broken"

[sub_resource type="Resource" id="idle_cast1"]
script = ExtResource("4_reaction")
when = 6
staff = 1
then = &"broken"

[sub_resource type="Resource" id="fusing_entered"]
script = ExtResource("4_reaction")
when = 5
cast = 1

[sub_resource type="Resource" id="fusing_death"]
script = ExtResource("4_reaction")
when = 4
cast = 2
then = &"broken"

[sub_resource type="Resource" id="fusing_cast1"]
script = ExtResource("4_reaction")
when = 6
staff = 1
then = &"broken"

[sub_resource type="Resource" id="fusing_cast2"]
script = ExtResource("4_reaction")
when = 6
staff = 2
then = &"broken"

[sub_resource type="Resource" id="idle"]
script = ExtResource("5_state")
state_id = &"idle"
reactions = Array[ExtResource("4_reaction")]([SubResource("idle_fire"), SubResource("idle_death"), SubResource("idle_cast1"), SubResource("idle_cast2")])

[sub_resource type="Resource" id="fusing"]
script = ExtResource("5_state")
state_id = &"fusing"
reactions = Array[ExtResource("4_reaction")]([SubResource("fusing_entered"), SubResource("fusing_death"), SubResource("fusing_cast1"), SubResource("fusing_cast2")])

[sub_resource type="Resource" id="broken"]
script = ExtResource("5_state")
state_id = &"broken"
blocks = false
hittable = false

[resource]
script = ExtResource("1_base")
id = &"test_barrel"
scene = ExtResource("6_scene")
max_health = 10.0
radius = 7.0
offset = Vector2(0, -8)
footprint_size = Vector2(14, 8)
footprint_offset = Vector2(0, -2)
staffs = Array[ExtResource("3_entry")]([SubResource("fuse"), SubResource("blast")])
states = Array[ExtResource("5_state")]([SubResource("idle"), SubResource("fusing"), SubResource("broken")])
